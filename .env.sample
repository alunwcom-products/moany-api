
# a valid database (MySQL) connection will be required
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# create a secret (passphrase) to sign your tokens (jwt)
JWT_SECRET=your_secret
JWT_EXPIRY=15m

EXPRESS_PORT=3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_REQUESTS=100
